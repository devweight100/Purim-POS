// 11. BANK ACCOUNTS & STORE SETTINGS
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model BankAccount {
  id            String   @id @default(uuid())
  bankName      String   @map("bank_name")
  accountName   String   @map("account_name")
  accountNumber String   @unique @map("account_number")
  branch        String?
  qrCodeUrl     String?  @map("qr_code_url")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("bank_accounts")
}

model StoreSettings {
  loyaltyConfig Json? @map("loyalty_config")
  id            String   @id @default(uuid())
  storeName     String   @default("à¸£à¹‰à¸²à¸™à¸›à¸¸à¸£à¸´à¸¡ POS") @map("store_name")
  branchName    String?  @map("branch_name")
  storePhone    String?  @map("store_phone")
  storeAddress  String?  @map("store_address")
  storeEmail    String?  @map("store_email")
  logoUrl       String?  @map("logo_url")
  qrImageUrl    String?  @map("qr_image_url")
  qrLabel       String?  @map("qr_label")
  taxId         String?  @map("tax_id")
  receiptHeader String?  @map("receipt_header")
  receiptFooter String?  @map("receipt_footer")
  vatRate       Decimal  @default(7) @map("vat_rate") @db.Decimal(5, 2)
  pointsPerBaht Decimal  @default(0.01) @map("points_per_baht") @db.Decimal(10, 4)
  pointValue    Decimal  @default(1) @map("point_value") @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
