// 8. CUSTOMERS & DEBTS (à¸¥à¸¹à¸à¸„à¹‰à¸² & à¸¥à¸¹à¸à¸«à¸™à¸µà¹‰)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Customer {
  id        String          @id @default(uuid())
  name      String
  phone     String?         @unique
  email     String?
  address   String?
  points    Int             @default(0)
  profile   Json?
  note      String?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  orders    Order[]
  debts     CustomerDebt[]
  claims    CustomerClaim[]

  @@map("customers")
}

model CustomerDebt {
  id              String        @id @default(uuid())
  customerId      String        @map("customer_id")
  orderId         String        @unique @map("order_id")
  totalDebt       Decimal       @map("total_debt") @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  remainingAmount Decimal       @map("remaining_amount") @db.Decimal(12, 2)
  dueDate         DateTime?     @map("due_date")
  status          DebtStatus    @default(PENDING)
  note            String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  customer        Customer      @relation(fields: [customerId], references: [id])
  order           Order         @relation(fields: [orderId], references: [id])
  payments        DebtPayment[]

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@map("customer_debts")
}

model DebtPayment {
  id            String        @id @default(uuid())
  debtId        String        @map("debt_id")
  amount        Decimal       @map("amount") @db.Decimal(12, 2)
  paymentMethod PaymentMethod @map("payment_method")
  referenceNo   String?       @map("reference_no")
  paymentDate   DateTime      @default(now()) @map("payment_date")
  cashierName   String        @map("cashier_name")
  receiptNo     String?       @map("receipt_no")
  note          String?
  createdAt     DateTime      @default(now()) @map("created_at")

  debt          CustomerDebt  @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
  @@index([paymentDate])
  @@map("debt_payments")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// 9. ORDERS & SALES (OFFLINE-FIRST RESILIENT)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Order {
  id             String        @id @default(uuid())
  clientOrderId  String?       @unique @map("client_order_id") // UUID Idempotency Key for offline sync
  orderNumber    String        @unique @map("order_number")    // ORD-YYYYMMDD-0001
  userId         String        @map("user_id")
  customerId     String?       @map("customer_id")
  shiftId        String?       @map("shift_id")
  status         OrderStatus   @default(COMPLETED)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(12, 2)
  totalCogs      Decimal       @default(0) @map("total_cogs") @db.Decimal(12, 2)
  pointsUsed     Int           @default(0) @map("points_used")
  pointsEarned   Int           @default(0) @map("points_earned")
  note           String?
  voidReason     String?       @map("void_reason")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")

  user           User          @relation(fields: [userId], references: [id])
  customer       Customer?     @relation(fields: [customerId], references: [id])
  shift          Shift?        @relation(fields: [shiftId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  debt           CustomerDebt?
  claims         CustomerClaim[]

  @@index([createdAt, status])
  @@index([userId])
  @@index([customerId])
  @@index([shiftId])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int
  baseQuantity Int? @map("base_quantity")
  unitName String? @map("unit_name")
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  unitCost  Decimal @default(0) @map("unit_cost") @db.Decimal(10, 2)
  total     Decimal @db.Decimal(12, 2)
  bundleData Json?  @map("bundle_data")

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String        @map("order_id")
  method      PaymentMethod
  amount      Decimal       @db.Decimal(12, 2)
  referenceNo String?       @map("reference_no")
  createdAt   DateTime      @default(now()) @map("created_at")

  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// 10. CLAIMS & CLAIM INVENTORY
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model CustomerClaim {
  id                 String      @id @default(uuid())
  claimNumber        String      @unique @map("claim_number") // CLM-YYYYMMDD-0001
  orderId            String?     @map("order_id")
  customerId         String?     @map("customer_id")
  productId          String      @map("product_id")
  serialNo           String?     @map("serial_no")
  claimType          ClaimType   @map("claim_type")
  problemDescription String      @map("problem_description")
  status             ClaimStatus @default(PENDING)
  resolutionNote     String?     @map("resolution_note")
  receivedDate       DateTime    @default(now()) @map("received_date")
  completedDate      DateTime?   @map("completed_date")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  // Real columns replacing legacy audit_logs CLAIM_META JSON
  quantity                Int      @default(1)
  unitName                String?  @map("unit_name")
  conversionFactor        Int      @default(1) @map("conversion_factor")
  baseQuantity            Int      @default(1) @map("base_quantity")
  unitPrice               Decimal? @map("unit_price") @db.Decimal(12, 2)
  totalClaimValue         Decimal? @map("total_claim_value") @db.Decimal(12, 2)
  refundAmount            Decimal? @map("refund_amount") @db.Decimal(12, 2)
  costPrice               Decimal? @map("cost_price") @db.Decimal(12, 2)
  totalCostValue          Decimal? @map("total_cost_value") @db.Decimal(12, 2)
  resolutionType          String?  @map("resolution_type")
  frontendStatus          String?  @map("frontend_status")
  cashierName             String?  @map("cashier_name")
  supplierId              String?  @map("supplier_id")
  returnNoteId            String?  @map("return_note_id")
  replacementProductId    String?  @map("replacement_product_id")
  replacementBaseQuantity Int?     @map("replacement_base_quantity")
  metadata                Json?

  order              Order?      @relation(fields: [orderId], references: [id])
  customer           Customer?   @relation(fields: [customerId], references: [id])
  product            Product     @relation(fields: [productId], references: [id])
  supplier           Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  returnNote         SupplierReturnNote? @relation(fields: [returnNoteId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([productId])
  @@index([customerId])
  @@index([supplierId])
  @@index([returnNoteId])
  @@map("customer_claims")
}

model ClaimInventory {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  quantity  Int      @default(0)
  unitCost  Decimal  @default(0) @map("unit_cost") @db.Decimal(10, 2)
  condition String?  // à¹€à¸Šà¹ˆà¸™ à¸‚à¸­à¸‡à¹€à¸ªà¸µà¸¢à¸£à¸­à¸ªà¹ˆà¸‡à¹€à¸„à¸¥à¸¡, à¸‹à¹ˆà¸­à¸¡à¹€à¸ªà¸£à¹‡à¸ˆà¹à¸¥à¹‰à¸§à¸£à¸­à¸ªà¹ˆà¸‡à¸¡à¸­à¸š
  location  String?  // à¸Šà¸±à¹‰à¸™à¸§à¸²à¸‡à¸„à¸¥à¸±à¸‡à¹€à¸„à¸¥à¸¡
  note      String?
  claimId       String?  @map("claim_id")
  customerId    String?  @map("customer_id")
  customerName  String?  @map("customer_name")
  customerPhone String?  @map("customer_phone")
  supplierId    String?  @map("supplier_id")
  supplierName  String?  @map("supplier_name")
  status        String?
  metadata      Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product   Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("claim_inventory")
}

