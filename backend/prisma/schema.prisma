generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// ENUMS
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
  WAREHOUSE
}

enum OrderStatus {
  PENDING
  COMPLETED
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  QR_PROMPTPAY
  CREDIT_CARD
  TRANSFER
  CREDIT_NOTE
  CREDIT_DEBT
}

enum POStatus {
  DRAFT
  PENDING
  ISSUED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum DebtStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum ClaimType {
  EXCHANGE
  REFUND
  WARRANTY
}

enum ClaimStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum ReturnNoteStatus {
  PENDING
  USED
  PARTIALLY_USED
  CANCELLED
}

enum VoucherStatus {
  ACTIVE
  CANCELLED
}

enum CashMovementType {
  IN
  OUT
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// 1. USERS & ACCESS CONTROL (ADMIN PANEL READY)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model User {
  id          String    @id @default(uuid())
  username    String    @unique
  password    String
  fullName    String    @map("full_name")
  role        UserRole  @default(CASHIER)
  pinCode     String?   @map("pin_code")     // 4-6 digit hashed PIN for fast cashier shift unlock
  permissions Json?                          // Granular permission keys: ["POS_SELL", "POS_DISCOUNT", "POS_VOID", "VIEW_REPORTS", etc.]
  isActive    Boolean   @default(true) @map("is_active")
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  orders      Order[]
  shifts      Shift[]
  auditLogs   AuditLog[]

  @@map("users")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// 2. SHIFTS (à¸à¸°à¸à¸²à¸£à¸—à¸³à¸‡à¸²à¸™ & à¹€à¸‡à¸´à¸™à¸ªà¸”à¸¥à¸´à¹‰à¸™à¸Šà¸±à¸)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Shift {
  id              String      @id @default(uuid())
  shiftNumber     String      @unique @map("shift_number") // SHF-YYYYMMDD-0001
  userId          String      @map("user_id")
  terminalId      String?     @map("terminal_id")
  openedAt        DateTime    @default(now()) @map("opened_at")
  closedAt        DateTime?   @map("closed_at")
  startingCash    Decimal     @default(0) @map("starting_cash") @db.Decimal(12, 2)
  cashSales       Decimal     @default(0) @map("cash_sales") @db.Decimal(12, 2)
  promptpaySales  Decimal     @default(0) @map("promptpay_sales") @db.Decimal(12, 2)
  creditCardSales Decimal     @default(0) @map("credit_card_sales") @db.Decimal(12, 2)
  debtSales       Decimal     @default(0) @map("debt_sales") @db.Decimal(12, 2)
  totalSales      Decimal     @default(0) @map("total_sales") @db.Decimal(12, 2)
  expectedCash    Decimal     @default(0) @map("expected_cash") @db.Decimal(12, 2)
  actualCash      Decimal?    @map("actual_cash") @db.Decimal(12, 2)
  cashDifference  Decimal?    @map("cash_difference") @db.Decimal(12, 2)
  status          ShiftStatus @default(OPEN)
  note            String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user            User        @relation(fields: [userId], references: [id])
  orders          Order[]
  cashMovements   CashMovement[]

  @@index([userId])
  @@index([openedAt])
  @@index([status])
  @@map("shifts")
}

model CashMovement {
  id        String           @id @default(uuid())
  shiftId   String           @map("shift_id")
  type      CashMovementType
  amount    Decimal          @db.Decimal(12, 2)
  reason    String
  createdAt DateTime         @default(now()) @map("created_at")

  shift     Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@index([createdAt])
  @@map("cash_movements")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// 3. PRODUCTS & CATEGORIES
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  color     String    @default("#6366f1")
  icon      String?   
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  products  Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?  
  sku         String   @unique
  categoryId  String?  @map("category_id")
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 2)
  costPrice   Decimal  @default(0) @map("cost_price") @db.Decimal(10, 2)
  priceLevel1 Decimal? @map("price_level_1") @db.Decimal(10, 2)
  priceLevel2 Decimal? @map("price_level_2") @db.Decimal(10, 2)
  priceLevel3 Decimal? @map("price_level_3") @db.Decimal(10, 2)
  priceLevel4 Decimal? @map("price_level_4") @db.Decimal(10, 2)
  priceLevel5 Decimal? @map("price_level_5") @db.Decimal(10, 2)
  unit        String?  @default("à¸Šà¸´à¹‰à¸™")
  imageUrl    String?  @map("image_url")
  isBundle    Boolean  @default(false) @map("is_bundle")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category        Category?         @relation(fields: [categoryId], references: [id])
  barcodes        ProductBarcode[]
  packagingUnits  ProductPackagingUnit[]
  images          ProductImage[]
  wholesalePrices ProductWholesalePrice[]
  stockBatches    StockBatch[]
  orderItems      OrderItem[]
  suppliers       ProductSupplier[]
  claims          CustomerClaim[]
  claimInventory  ClaimInventory[]
  purchaseOrderItems PurchaseOrderItem[]
  bundleItems     ProductBundleItem[] @relation("BundleParent")
  partOfBundles   ProductBundleItem[] @relation("BundleChild")

  @@index([categoryId])
  @@index([name])
  @@map("products")
}

model ProductBundleItem {
  id              String   @id @default(uuid())
  bundleProductId String   @map("bundle_product_id")
  childProductId  String   @map("child_product_id")
  quantity        Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  bundleProduct   Product  @relation("BundleParent", fields: [bundleProductId], references: [id], onDelete: Cascade)
  childProduct    Product  @relation("BundleChild", fields: [childProductId], references: [id], onDelete: Cascade)

  @@unique([bundleProductId, childProductId])
  @@index([bundleProductId])
  @@index([childProductId])
  @@map("product_bundle_items")
}

model ProductBarcode {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  barcode   String   @unique
  label     String?  
  createdAt DateTime @default(now()) @map("created_at")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_barcodes")
}

model ProductPackagingUnit {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  name        String
  qtyPerPrev  Int      @default(1) @map("qty_per_prev")
  barcode     String?
  priceLevel1 Decimal? @map("price_level_1") @db.Decimal(10, 2)
  priceLevel2 Decimal? @map("price_level_2") @db.Decimal(10, 2)
  priceLevel3 Decimal? @map("price_level_3") @db.Decimal(10, 2)
  priceLevel4 Decimal? @map("price_level_4") @db.Decimal(10, 2)
  priceLevel5 Decimal? @map("price_level_5") @db.Decimal(10, 2)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([barcode])
  @@map("product_packaging_units")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  dataUrl    String   @map("data_url") @db.Text
  name      String?
  isCover   Boolean  @default(false) @map("is_cover")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductWholesalePrice {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  minQuantity Int      @map("min_quantity")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_wholesale_prices")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// 4. INVENTORY & FIFO STOCK BATCHES
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model StockBatch {
  id                String         @id @default(uuid())
  productId         String         @map("product_id")
  quantityReceived  Int            @map("quantity_received")
  quantityRemaining Int            @map("quantity_remaining")
  unitCost          Decimal        @map("unit_cost") @db.Decimal(10, 2)
  receivedAt        DateTime       @default(now()) @map("received_at")
  supplierId        String?        @map("supplier_id")
  purchaseOrderId   String?        @map("purchase_order_id")
  note              String?

  product           Product        @relation(fields: [productId], references: [id])
  supplier          Supplier?      @relation(fields: [supplierId], references: [id])
  purchaseOrder     PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@index([productId, quantityRemaining])
  @@index([receivedAt])
  @@map("stock_batches")
}

model ProductSupplier {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  supplierId  String   @map("supplier_id")
  supplierSku String?  @map("supplier_sku")
  unitCost    Decimal? @map("unit_cost") @db.Decimal(10, 2)
  isPreferred Boolean  @default(false) @map("is_preferred")
  createdAt   DateTime @default(now()) @map("created_at")

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// 5. SUPPLIERS & PROCUREMENT (PO)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Supplier {
  id          String   @id @default(uuid())
  name        String
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  address     String?
  creditTerms Int?     @map("credit_terms")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  stockBatches    StockBatch[]
  purchaseOrders  PurchaseOrder[]
  products        ProductSupplier[]
  returnNotes     SupplierReturnNote[]
  customerClaims  CustomerClaim[]
  paymentVouchers PaymentVoucher[]

  @@map("suppliers")
}

model PurchaseOrder {
  id                String        @id @default(uuid())
  poNumber          String        @unique @map("po_number")
  supplierId        String        @map("supplier_id")
  supplierInvoiceNo String?       @map("supplier_invoice_no") // à¹€à¸¥à¸‚à¸—à¸µà¹ˆà¸šà¸´à¸¥à¸„à¸¹à¹ˆà¸„à¹‰à¸²
  billDate          DateTime      @default(now()) @map("bill_date")
  dueDate           DateTime?     @map("due_date")
  status            POStatus      @default(DRAFT)
  paymentStatus     PaymentStatus @default(UNPAID) @map("payment_status")
  totalAmount       Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  paidAmount        Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  remainingPayable  Decimal       @default(0) @map("remaining_payable") @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  supplier          Supplier              @relation(fields: [supplierId], references: [id])
  items             PurchaseOrderItem[]
  stockBatches      StockBatch[]
  voucherItems      PaymentVoucherItem[]

  @@index([supplierId])
  @@index([paymentStatus])
  @@index([billDate])
  @@index([supplierInvoiceNo])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String        @map("purchase_order_id")
  productId       String        @map("product_id")
  quantity        Int
  unitCost        Decimal       @map("unit_cost") @db.Decimal(10, 2)
  receivedQty     Int           @default(0) @map("received_qty")
  total           Decimal       @default(0) @map("total") @db.Decimal(12, 2)

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// 6. PAYMENT VOUCHERS (à¹ƒà¸šà¸ªà¸³à¸„à¸±à¸à¸ˆà¹ˆà¸²à¸¢ A4 & à¸Šà¸³à¸£à¸°à¸«à¸¥à¸²à¸¢à¸šà¸´à¸¥)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model PaymentVoucher {
  id               String               @id @default(uuid())
  voucherNumber    String               @unique @map("voucher_number") // PV-YYYYMMDD-0001
  supplierId       String               @map("supplier_id")
  paymentDate      DateTime             @default(now()) @map("payment_date")
  totalBillsAmount Decimal              @map("total_bills_amount") @db.Decimal(12, 2)
  debitDeducted    Decimal              @default(0) @map("debit_deducted") @db.Decimal(12, 2)
  discountAmount   Decimal              @default(0) @map("discount_amount") @db.Decimal(12, 2)
  netPaidAmount    Decimal              @map("net_paid_amount") @db.Decimal(12, 2)
  paymentMethod    PaymentMethod        @map("payment_method")
  bankAccountLabel String?              @map("bank_account_label")
  referenceNo      String?              @map("reference_no")
  note             String?
  cashierName      String               @map("cashier_name")
  status           VoucherStatus        @default(ACTIVE)
  cancelledAt      DateTime?            @map("cancelled_at")
  cancelReason     String?              @map("cancel_reason")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  supplier         Supplier             @relation(fields: [supplierId], references: [id])
  items            PaymentVoucherItem[]
  debitNotes       PaymentVoucherDebit[]

  @@index([supplierId])
  @@index([paymentDate])
  @@index([status])
  @@map("payment_vouchers")
}

model PaymentVoucherItem {
  id              String         @id @default(uuid())
  voucherId       String         @map("voucher_id")
  purchaseOrderId String         @map("purchase_order_id")
  amountPaid      Decimal        @map("amount_paid") @db.Decimal(12, 2)

  voucher         PaymentVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])

  @@index([voucherId])
  @@index([purchaseOrderId])
  @@map("payment_voucher_items")
}

model PaymentVoucherDebit {
  id             String             @id @default(uuid())
  voucherId      String             @map("voucher_id")
  returnNoteId   String             @map("return_note_id")
  amountDeducted Decimal            @map("amount_deducted") @db.Decimal(12, 2)

  voucher        PaymentVoucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  returnNote     SupplierReturnNote @relation(fields: [returnNoteId], references: [id])

  @@index([voucherId])
  @@index([returnNoteId])
  @@map("payment_voucher_debits")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// 7. SUPPLIER RETURNS & DEBIT NOTES (à¸ªà¹ˆà¸‡à¹€à¸„à¸¥à¸¡ & à¹ƒà¸šà¸¥à¸”à¸«à¸™à¸µà¹‰)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model SupplierReturnNote {
  id                    String                @id @default(uuid()) // DN-YYYY-0001
  returnNumber          String                @unique @map("return_number")
  supplierId            String                @map("supplier_id")
  totalQuantity         Int                   @default(0) @map("total_quantity")
  totalAmount           Decimal               @map("total_amount") @db.Decimal(12, 2)
  remainingCreditAmount Decimal               @map("remaining_credit_amount") @db.Decimal(12, 2)
  status                ReturnNoteStatus      @default(PENDING)
  note                  String?
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  supplier              Supplier              @relation(fields: [supplierId], references: [id])
  voucherDebits         PaymentVoucherDebit[]
  items                 SupplierReturnNoteItem[]
  deductions            SupplierReturnNoteDeduction[]
  claims                CustomerClaim[]
  metadata              Json?

  @@index([supplierId])
  @@index([status])
  @@map("supplier_return_notes")
}

model SupplierReturnNoteItem {
  id          String   @id @default(uuid())
  noteId      String   @map("note_id")
  sortOrder   Int      @default(0) @map("sort_order")
  productId   String?  @map("product_id")
  claimId     String?  @map("claim_id") // may hold comma-separated claim ids/numbers
  itemType    String   @default("DEFECTIVE") @map("item_type") // DEFECTIVE | OVERSTOCK
  productName String?  @map("product_name")
  sku         String?
  unitName    String?  @map("unit_name")
  quantity    Int      @default(0)
  unitCost    Decimal  @default(0) @map("unit_cost") @db.Decimal(12, 2)
  total       Decimal  @default(0) @db.Decimal(12, 2)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  note        SupplierReturnNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([productId])
  @@map("supplier_return_note_items")
}

model SupplierReturnNoteDeduction {
  id        String   @id @default(uuid())
  noteId    String   @map("note_id")
  amount    Decimal  @db.Decimal(12, 2)
  reference String?
  netPaid   Decimal? @map("net_paid") @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  returnNote SupplierReturnNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@map("supplier_return_note_deductions")
}

model ReplacementWarranty {
  id                  String    @id @default(uuid())
  originalClaimId     String?   @map("original_claim_id") // claim number
  originalOrderId     String?   @map("original_order_id")
  originalOrderNumber String?   @map("original_order_number")
  replacementDate     DateTime? @map("replacement_date")
  customerId          String?   @map("customer_id")
  customerName        String?   @map("customer_name")
  customerPhone       String?   @map("customer_phone")
  productId           String?   @map("product_id")
  productName         String?   @map("product_name")
  sku                 String?
  unitName            String?   @map("unit_name")
  unitPrice           Decimal?  @map("unit_price") @db.Decimal(12, 2)
  isClaimed           Boolean   @default(false) @map("is_claimed")
  claimId             String?   @map("claim_id") // claim number that consumed this warranty
  metadata            Json?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([originalClaimId])
  @@index([customerId])
  @@map("replacement_warranties")
}

