generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
  WAREHOUSE
}

enum OrderStatus {
  PENDING
  COMPLETED
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  QR_PROMPTPAY
  CREDIT_CARD
  TRANSFER
  CREDIT_NOTE
  CREDIT_DEBT
}

enum POStatus {
  DRAFT
  PENDING
  ISSUED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum DebtStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum ClaimType {
  EXCHANGE
  REFUND
  WARRANTY
}

enum ClaimStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum ReturnNoteStatus {
  PENDING
  USED
  PARTIALLY_USED
  CANCELLED
}

enum VoucherStatus {
  ACTIVE
  CANCELLED
}

enum CashMovementType {
  IN
  OUT
}

enum MoneyAccountType {
  CASH_DRAWER   // cash drawer of one POS terminal
  CASH_SAFE     // store / office cash (where drawers are emptied at shift close)
  BANK          // bank account (linked to BankAccount used for QR / transfer)
  CARD_CLEARING // card sales waiting for the card company to pay out
}

enum MoneyDirection {
  IN
  OUT
}

// ──────────────────────────────────────────────
// 1. USERS & ACCESS CONTROL (ADMIN PANEL READY)
// ──────────────────────────────────────────────

model User {
  id          String    @id @default(uuid())
  username    String    @unique
  password    String
  fullName    String    @map("full_name")
  role        UserRole  @default(CASHIER)
  pinCode     String?   @map("pin_code")     // 4-6 digit hashed PIN for fast cashier shift unlock
  permissions Json?                          // Granular permission keys: ["POS_SELL", "POS_DISCOUNT", "POS_VOID", "VIEW_REPORTS", etc.]
  isActive    Boolean   @default(true) @map("is_active")
  tokenVersion Int @default(0) @map("token_version") // bumped on password/PIN change or deactivation: older JWTs are rejected
  mustChangePassword Boolean @default(false) @map("must_change_password") // forced after login with a default/temporary credential
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  orders      Order[]
  shifts      Shift[]
  auditLogs   AuditLog[]

  @@map("users")
}

// ──────────────────────────────────────────────
// 2. SHIFTS (กะการทำงาน & เงินสดลิ้นชัก)
// ──────────────────────────────────────────────

model Shift {
  id              String      @id @default(uuid())
  shiftNumber     String      @unique @map("shift_number") // SHF-YYYYMMDD-0001
  userId          String      @map("user_id")
  terminalId      String?     @map("terminal_id")
  openedAt        DateTime    @default(now()) @map("opened_at")
  closedAt        DateTime?   @map("closed_at")
  startingCash    Decimal     @default(0) @map("starting_cash") @db.Decimal(12, 2)
  cashSales       Decimal     @default(0) @map("cash_sales") @db.Decimal(12, 2)
  promptpaySales  Decimal     @default(0) @map("promptpay_sales") @db.Decimal(12, 2)
  creditCardSales Decimal     @default(0) @map("credit_card_sales") @db.Decimal(12, 2)
  debtSales       Decimal     @default(0) @map("debt_sales") @db.Decimal(12, 2)
  totalSales      Decimal     @default(0) @map("total_sales") @db.Decimal(12, 2)
  expectedCash    Decimal     @default(0) @map("expected_cash") @db.Decimal(12, 2)
  actualCash      Decimal?    @map("actual_cash") @db.Decimal(12, 2)
  cashDifference  Decimal?    @map("cash_difference") @db.Decimal(12, 2)
  status          ShiftStatus @default(OPEN)
  note            String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user            User        @relation(fields: [userId], references: [id])
  orders          Order[]
  cashMovements   CashMovement[]

  @@index([userId])
  @@index([openedAt])
  @@index([status])
  @@map("shifts")
}

model CashMovement {
  id        String           @id @default(uuid())
  shiftId   String           @map("shift_id")
  type      CashMovementType
  amount    Decimal          @db.Decimal(12, 2)
  category  String           @default("GENERAL") // GENERAL | REFUND | DEBT_PAYMENT
  reason    String
  createdAt DateTime         @default(now()) @map("created_at")

  shift     Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@index([createdAt])
  @@map("cash_movements")
}

// ──────────────────────────────────────────────
// 3. PRODUCTS & CATEGORIES
// ──────────────────────────────────────────────

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  color     String    @default("#6366f1")
  icon      String?   
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  products  Product[]

  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?  
  sku         String   @unique
  categoryId  String?  @map("category_id")
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 2)
  costPrice   Decimal  @default(0) @map("cost_price") @db.Decimal(10, 2)
  priceLevel1 Decimal? @map("price_level_1") @db.Decimal(10, 2)
  priceLevel2 Decimal? @map("price_level_2") @db.Decimal(10, 2)
  priceLevel3 Decimal? @map("price_level_3") @db.Decimal(10, 2)
  priceLevel4 Decimal? @map("price_level_4") @db.Decimal(10, 2)
  priceLevel5 Decimal? @map("price_level_5") @db.Decimal(10, 2)
  unit        String?  @default("ชิ้น")
  imageUrl    String?  @map("image_url")
  isBundle    Boolean  @default(false) @map("is_bundle")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category        Category?         @relation(fields: [categoryId], references: [id])
  barcodes        ProductBarcode[]
  packagingUnits  ProductPackagingUnit[]
  images          ProductImage[]
  wholesalePrices ProductWholesalePrice[]
  stockBatches    StockBatch[]
  orderItems      OrderItem[]
  suppliers       ProductSupplier[]
  claims          CustomerClaim[]
  claimInventory  ClaimInventory[]
  purchaseOrderItems PurchaseOrderItem[]
  bundleItems     ProductBundleItem[] @relation("BundleParent")
  partOfBundles   ProductBundleItem[] @relation("BundleChild")

  @@index([categoryId])
  @@index([name])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@index([sku(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_sku_trgm_idx")
  @@map("products")
}

model ProductBundleItem {
  id              String   @id @default(uuid())
  bundleProductId String   @map("bundle_product_id")
  childProductId  String   @map("child_product_id")
  quantity        Decimal  @default(1) @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  bundleProduct   Product  @relation("BundleParent", fields: [bundleProductId], references: [id], onDelete: Cascade)
  childProduct    Product  @relation("BundleChild", fields: [childProductId], references: [id], onDelete: Cascade)

  @@unique([bundleProductId, childProductId])
  @@index([bundleProductId])
  @@index([childProductId])
  @@map("product_bundle_items")
}

model ProductBarcode {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  barcode   String   @unique
  label     String?  
  createdAt DateTime @default(now()) @map("created_at")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([barcode(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_barcodes_barcode_trgm_idx")
  @@map("product_barcodes")
}

model ProductPackagingUnit {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  name        String
  qtyPerPrev  Int      @default(1) @map("qty_per_prev")
  barcode     String?
  priceLevel1 Decimal? @map("price_level_1") @db.Decimal(10, 2)
  priceLevel2 Decimal? @map("price_level_2") @db.Decimal(10, 2)
  priceLevel3 Decimal? @map("price_level_3") @db.Decimal(10, 2)
  priceLevel4 Decimal? @map("price_level_4") @db.Decimal(10, 2)
  priceLevel5 Decimal? @map("price_level_5") @db.Decimal(10, 2)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([barcode])
  @@index([barcode(ops: raw("gin_trgm_ops"))], type: Gin, map: "product_packaging_units_barcode_trgm_idx")
  @@map("product_packaging_units")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  dataUrl    String   @map("data_url") @db.Text
  /// small JPEG made by the browser when the photo is saved (null for older rows: the full image is served)
  thumbDataUrl String? @map("thumb_data_url") @db.Text
  name      String?
  isCover   Boolean  @default(false) @map("is_cover")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

/// Append-only change log of the POS catalogue, filled by database triggers (migration
/// 20261124000000_product_sync) on products, stock batches, barcodes, packaging units, images, wholesale
/// prices, product suppliers, bundle items, categories and suppliers. GET /products/sync returns the
/// products whose rows were committed after the client's snapshot (xid not visible in it).
model ProductChange {
  id        BigInt                 @id @default(autoincrement())
  productId String                 @map("product_id")
  xid       Unsupported("xid8")    @default(dbgenerated("pg_current_xact_id()"))
  changedAt DateTime               @default(now()) @map("changed_at")

  @@index([xid])
  @@index([changedAt])
  @@map("product_changes")
}

/// Change log of the customer list delta sync (GET /customers/sync); rows written by triggers on customers and
/// customer_debts (see migration 20261126000000_customer_sync).
model CustomerChange {
  id         BigInt                 @id @default(autoincrement())
  customerId String                 @map("customer_id")
  xid        Unsupported("xid8")    @default(dbgenerated("pg_current_xact_id()"))
  changedAt  DateTime               @default(now()) @map("changed_at")

  @@index([xid])
  @@index([changedAt])
  @@map("customer_changes")
}

model ProductWholesalePrice {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  minQuantity Decimal  @map("min_quantity") @db.Decimal(12, 2)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(10, 2)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_wholesale_prices")
}

// ──────────────────────────────────────────────
// 4. INVENTORY & FIFO STOCK BATCHES
// ──────────────────────────────────────────────

model StockBatch {
  id                String         @id @default(uuid())
  productId         String         @map("product_id")
  quantityReceived  Decimal        @map("quantity_received") @db.Decimal(12, 2)
  quantityRemaining Decimal        @map("quantity_remaining") @db.Decimal(12, 2)
  unitCost          Decimal        @map("unit_cost") @db.Decimal(14, 4)
  receivedAt        DateTime       @default(now()) @map("received_at")
  supplierId        String?        @map("supplier_id")
  purchaseOrderId   String?        @map("purchase_order_id")
  note              String?

  product           Product        @relation(fields: [productId], references: [id])
  supplier          Supplier?      @relation(fields: [supplierId], references: [id])
  purchaseOrder     PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@index([productId, quantityRemaining])
  @@index([receivedAt])
  @@map("stock_batches")
}

model ProductSupplier {
  id          String   @id @default(uuid())
  productId   String   @map("product_id")
  supplierId  String   @map("supplier_id")
  supplierSku String?  @map("supplier_sku")
  unitCost    Decimal? @map("unit_cost") @db.Decimal(10, 2)
  isPreferred Boolean  @default(false) @map("is_preferred")
  createdAt   DateTime @default(now()) @map("created_at")

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

// ──────────────────────────────────────────────
// 5. SUPPLIERS & PROCUREMENT (PO)
// ──────────────────────────────────────────────

model Supplier {
  id          String   @id @default(uuid())
  name        String
  contactName String?  @map("contact_name")
  phone       String?
  email       String?
  address     String?
  creditTerms Int?     @map("credit_terms")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  stockBatches    StockBatch[]
  purchaseOrders  PurchaseOrder[]
  products        ProductSupplier[]
  returnNotes     SupplierReturnNote[]
  customerClaims  CustomerClaim[]
  paymentVouchers PaymentVoucher[]

  @@map("suppliers")
}

model PurchaseOrder {
  id                String        @id @default(uuid())
  poNumber          String        @unique @map("po_number")
  supplierId        String        @map("supplier_id")
  supplierInvoiceNo String?       @map("supplier_invoice_no") // เลขที่บิลคู่ค้า
  billDate          DateTime      @default(now()) @map("bill_date")
  dueDate           DateTime?     @map("due_date")
  status            POStatus      @default(DRAFT)
  paymentStatus     PaymentStatus @default(UNPAID) @map("payment_status")
  billDiscountType  String        @default("baht") @map("bill_discount_type")
  billDiscountValue Decimal       @default(0) @map("bill_discount_value") @db.Decimal(12, 2)
  discountAmount    Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2) // line + bill discounts
  subtotalAmount    Decimal       @default(0) @map("subtotal_amount") @db.Decimal(12, 2) // before VAT, after discounts
  vatAmount         Decimal       @default(0) @map("vat_amount") @db.Decimal(12, 2)      // purchase (input) VAT
  totalAmount       Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)    // owed to the supplier (incl. VAT)
  paidAmount        Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  remainingPayable  Decimal       @default(0) @map("remaining_payable") @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  supplier          Supplier              @relation(fields: [supplierId], references: [id])
  items             PurchaseOrderItem[]
  stockBatches      StockBatch[]
  voucherItems      PaymentVoucherItem[]

  @@index([supplierId])
  @@index([paymentStatus])
  @@index([billDate])
  @@index([supplierInvoiceNo])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String        @map("purchase_order_id")
  productId       String        @map("product_id")
  quantity        Decimal       @db.Decimal(12, 2)
  unitCost        Decimal       @map("unit_cost") @db.Decimal(10, 2)
  receivedQty     Decimal       @default(0) @map("received_qty") @db.Decimal(12, 2)
  discountType    String        @default("baht") @map("discount_type")
  discountValue   Decimal       @default(0) @map("discount_value") @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2) // line + share of bill discount
  vatType         String        @default("NONE") @map("vat_type") // NONE | INCLUDED | EXCLUDED
  vatRate         Decimal       @default(0) @map("vat_rate") @db.Decimal(5, 2)
  netAmount       Decimal       @default(0) @map("net_amount") @db.Decimal(12, 2)
  vatAmount       Decimal       @default(0) @map("vat_amount") @db.Decimal(12, 2)
  total           Decimal       @default(0) @map("total") @db.Decimal(12, 2) // owed for this line (incl. VAT)

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

// ──────────────────────────────────────────────
// 6. PAYMENT VOUCHERS (ใบสำคัญจ่าย A4 & ชำระหลายบิล)
// ──────────────────────────────────────────────

model PaymentVoucher {
  id               String               @id @default(uuid())
  voucherNumber    String               @unique @map("voucher_number") // PV-YYYYMMDD-0001
  supplierId       String               @map("supplier_id")
  paymentDate      DateTime             @default(now()) @map("payment_date")
  totalBillsAmount Decimal              @map("total_bills_amount") @db.Decimal(12, 2)
  debitDeducted    Decimal              @default(0) @map("debit_deducted") @db.Decimal(12, 2)
  discountAmount   Decimal              @default(0) @map("discount_amount") @db.Decimal(12, 2)
  netPaidAmount    Decimal              @map("net_paid_amount") @db.Decimal(12, 2)
  paymentMethod    PaymentMethod        @map("payment_method")
  bankAccountLabel String?              @map("bank_account_label")
  referenceNo      String?              @map("reference_no")
  note             String?
  cashierName      String               @map("cashier_name")
  status           VoucherStatus        @default(ACTIVE)
  cancelledAt      DateTime?            @map("cancelled_at")
  cancelReason     String?              @map("cancel_reason")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  supplier         Supplier             @relation(fields: [supplierId], references: [id])
  items            PaymentVoucherItem[]
  debitNotes       PaymentVoucherDebit[]

  @@index([supplierId])
  @@index([paymentDate])
  @@index([status])
  @@map("payment_vouchers")
}

model PaymentVoucherItem {
  id              String         @id @default(uuid())
  voucherId       String         @map("voucher_id")
  purchaseOrderId String         @map("purchase_order_id")
  amountPaid      Decimal        @map("amount_paid") @db.Decimal(12, 2)

  voucher         PaymentVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])

  @@index([voucherId])
  @@index([purchaseOrderId])
  @@map("payment_voucher_items")
}

model PaymentVoucherDebit {
  id             String             @id @default(uuid())
  voucherId      String             @map("voucher_id")
  returnNoteId   String             @map("return_note_id")
  amountDeducted Decimal            @map("amount_deducted") @db.Decimal(12, 2)

  voucher        PaymentVoucher     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  returnNote     SupplierReturnNote @relation(fields: [returnNoteId], references: [id])

  @@index([voucherId])
  @@index([returnNoteId])
  @@map("payment_voucher_debits")
}

// ──────────────────────────────────────────────
// 7. SUPPLIER RETURNS & DEBIT NOTES (ส่งเคลม & ใบลดหนี้)
// ──────────────────────────────────────────────

model SupplierReturnNote {
  id                    String                @id @default(uuid()) // DN-YYYY-0001
  returnNumber          String                @unique @map("return_number")
  supplierId            String                @map("supplier_id")
  totalQuantity         Decimal               @default(0) @map("total_quantity") @db.Decimal(12, 2)
  totalAmount           Decimal               @map("total_amount") @db.Decimal(12, 2)
  remainingCreditAmount Decimal               @map("remaining_credit_amount") @db.Decimal(12, 2)
  status                ReturnNoteStatus      @default(PENDING)
  note                  String?
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  supplier              Supplier              @relation(fields: [supplierId], references: [id])
  voucherDebits         PaymentVoucherDebit[]
  items                 SupplierReturnNoteItem[]
  deductions            SupplierReturnNoteDeduction[]
  claims                CustomerClaim[]
  metadata              Json?

  @@index([supplierId])
  @@index([status])
  @@map("supplier_return_notes")
}

model SupplierReturnNoteItem {
  id          String   @id @default(uuid())
  noteId      String   @map("note_id")
  sortOrder   Int      @default(0) @map("sort_order")
  productId   String?  @map("product_id")
  claimId     String?  @map("claim_id") // may hold comma-separated claim ids/numbers
  itemType    String   @default("DEFECTIVE") @map("item_type") // DEFECTIVE | OVERSTOCK
  productName String?  @map("product_name")
  sku         String?
  unitName    String?  @map("unit_name")
  quantity    Decimal  @default(0) @db.Decimal(12, 2)
  unitCost    Decimal  @default(0) @map("unit_cost") @db.Decimal(12, 2)
  total       Decimal  @default(0) @db.Decimal(12, 2)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  note        SupplierReturnNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@index([productId])
  @@map("supplier_return_note_items")
}

model SupplierReturnNoteDeduction {
  id        String   @id @default(uuid())
  noteId    String   @map("note_id")
  amount    Decimal  @db.Decimal(12, 2)
  reference String?
  netPaid   Decimal? @map("net_paid") @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  returnNote SupplierReturnNote @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@map("supplier_return_note_deductions")
}

model ReplacementWarranty {
  id                  String    @id @default(uuid())
  originalClaimId     String?   @map("original_claim_id") // claim number
  originalOrderId     String?   @map("original_order_id")
  originalOrderNumber String?   @map("original_order_number")
  replacementDate     DateTime? @map("replacement_date")
  customerId          String?   @map("customer_id")
  customerName        String?   @map("customer_name")
  customerPhone       String?   @map("customer_phone")
  productId           String?   @map("product_id")
  productName         String?   @map("product_name")
  sku                 String?
  unitName            String?   @map("unit_name")
  unitPrice           Decimal?  @map("unit_price") @db.Decimal(12, 2)
  isClaimed           Boolean   @default(false) @map("is_claimed")
  claimId             String?   @map("claim_id") // claim number that consumed this warranty
  metadata            Json?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([originalClaimId])
  @@index([customerId])
  @@map("replacement_warranties")
}

// ──────────────────────────────────────────────
// 8. CUSTOMERS & DEBTS (ลูกค้า & ลูกหนี้)
// ──────────────────────────────────────────────

model Customer {
  id        String          @id @default(uuid())
  name      String
  phone     String?         @unique
  email     String?
  address   String?
  points    Int             @default(0)
  profile   Json?
  note      String?
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  orders    Order[]
  debts     CustomerDebt[]
  claims    CustomerClaim[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_phone_trgm_idx")
  @@map("customers")
}

model CustomerDebt {
  id              String        @id @default(uuid())
  customerId      String        @map("customer_id")
  orderId         String        @unique @map("order_id")
  totalDebt       Decimal       @map("total_debt") @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  remainingAmount Decimal       @map("remaining_amount") @db.Decimal(12, 2)
  dueDate         DateTime?     @map("due_date")
  status          DebtStatus    @default(PENDING)
  note            String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  customer        Customer      @relation(fields: [customerId], references: [id])
  order           Order         @relation(fields: [orderId], references: [id])
  payments        DebtPayment[]

  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@map("customer_debts")
}

model DebtPayment {
  id            String        @id @default(uuid())
  debtId        String        @map("debt_id")
  amount        Decimal       @map("amount") @db.Decimal(12, 2)
  paymentMethod PaymentMethod @map("payment_method")
  referenceNo   String?       @map("reference_no")
  paymentDate   DateTime      @default(now()) @map("payment_date")
  cashierName   String        @map("cashier_name")
  receiptNo     String?       @map("receipt_no")
  note          String?
  cancelledAt   DateTime?     @map("cancelled_at")
  cancelReason  String?       @map("cancel_reason")
  cancelledBy   String?       @map("cancelled_by")
  createdAt     DateTime      @default(now()) @map("created_at")

  debt          CustomerDebt  @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
  @@index([paymentDate])
  @@map("debt_payments")
}

// ──────────────────────────────────────────────
// 9. ORDERS & SALES (OFFLINE-FIRST RESILIENT)
// ──────────────────────────────────────────────

model Order {
  id             String        @id @default(uuid())
  clientOrderId  String?       @unique @map("client_order_id") // UUID Idempotency Key for offline sync
  orderNumber    String        @unique @map("order_number")    // ORD-YYYYMMDD-0001
  userId         String        @map("user_id")
  customerId     String?       @map("customer_id")
  shiftId        String?       @map("shift_id")
  status         OrderStatus   @default(COMPLETED)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal       @map("total_amount") @db.Decimal(12, 2)
  totalCogs      Decimal       @default(0) @map("total_cogs") @db.Decimal(12, 2)
  vatRate        Decimal       @default(0) @map("vat_rate") @db.Decimal(5, 2)    // % used for this bill (0 = no VAT)
  vatAmount      Decimal       @default(0) @map("vat_amount") @db.Decimal(12, 2) // VAT included in totalAmount
  returnedAmount Decimal       @default(0) @map("returned_amount") @db.Decimal(12, 2) // refunded through partial returns
  approvalId     String?       @map("approval_id") // manager approval used for discounts / below-cost prices
  pointsUsed     Int           @default(0) @map("points_used")
  pointsEarned   Int           @default(0) @map("points_earned")
  note           String?
  voidReason     String?       @map("void_reason")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at")

  user           User          @relation(fields: [userId], references: [id])
  customer       Customer?     @relation(fields: [customerId], references: [id])
  shift          Shift?        @relation(fields: [shiftId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  debt           CustomerDebt?
  claims         CustomerClaim[]
  returns        OrderReturn[]

  @@index([createdAt, status])
  @@index([userId])
  @@index([customerId])
  @@index([shiftId])
  @@index([orderNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "orders_order_number_trgm_idx")
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Decimal @db.Decimal(12, 2)
  baseQuantity Decimal? @map("base_quantity") @db.Decimal(12, 2)
  unitName String? @map("unit_name")
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  unitCost  Decimal @default(0) @map("unit_cost") @db.Decimal(10, 2)
  total     Decimal @db.Decimal(12, 2)
  bundleData Json?  @map("bundle_data")

  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String        @map("order_id")
  method      PaymentMethod
  amount      Decimal       @db.Decimal(12, 2)
  referenceNo String?       @map("reference_no")
  bankAccountId String?     @map("bank_account_id") // bank that received a QR / transfer payment
  createdAt   DateTime      @default(now()) @map("created_at")

  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

// ──────────────────────────────────────────────
// 10. CLAIMS & CLAIM INVENTORY
// ──────────────────────────────────────────────

model CustomerClaim {
  id                 String      @id @default(uuid())
  claimNumber        String      @unique @map("claim_number") // CLM-YYYYMMDD-0001
  orderId            String?     @map("order_id")
  customerId         String?     @map("customer_id")
  productId          String      @map("product_id")
  serialNo           String?     @map("serial_no")
  claimType          ClaimType   @map("claim_type")
  problemDescription String      @map("problem_description")
  status             ClaimStatus @default(PENDING)
  resolutionNote     String?     @map("resolution_note")
  receivedDate       DateTime    @default(now()) @map("received_date")
  completedDate      DateTime?   @map("completed_date")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  // Real columns replacing legacy audit_logs CLAIM_META JSON
  quantity                Decimal  @default(1) @db.Decimal(12, 2)
  unitName                String?  @map("unit_name")
  conversionFactor        Int      @default(1) @map("conversion_factor")
  baseQuantity            Decimal  @default(1) @map("base_quantity") @db.Decimal(12, 2)
  unitPrice               Decimal? @map("unit_price") @db.Decimal(12, 2)
  totalClaimValue         Decimal? @map("total_claim_value") @db.Decimal(12, 2)
  refundAmount            Decimal? @map("refund_amount") @db.Decimal(12, 2)
  costPrice               Decimal? @map("cost_price") @db.Decimal(12, 2)
  totalCostValue          Decimal? @map("total_cost_value") @db.Decimal(12, 2)
  resolutionType          String?  @map("resolution_type")
  frontendStatus          String?  @map("frontend_status")
  cashierName             String?  @map("cashier_name")
  supplierId              String?  @map("supplier_id")
  returnNoteId            String?  @map("return_note_id")
  replacementProductId    String?  @map("replacement_product_id")
  replacementBaseQuantity Decimal? @map("replacement_base_quantity") @db.Decimal(12, 2)
  metadata                Json?

  order              Order?      @relation(fields: [orderId], references: [id])
  customer           Customer?   @relation(fields: [customerId], references: [id])
  product            Product     @relation(fields: [productId], references: [id])
  supplier           Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  returnNote         SupplierReturnNote? @relation(fields: [returnNoteId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([productId])
  @@index([customerId])
  @@index([supplierId])
  @@index([returnNoteId])
  @@index([createdAt]) // claim accounting per period (reports, P&L)
  @@map("customer_claims")
}

model ClaimInventory {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  quantity  Decimal  @default(0) @db.Decimal(12, 2)
  unitCost  Decimal  @default(0) @map("unit_cost") @db.Decimal(10, 2)
  condition String?  // เช่น ของเสียรอส่งเคลม, ซ่อมเสร็จแล้วรอส่งมอบ
  location  String?  // ชั้นวางคลังเคลม
  note      String?
  claimId       String?  @map("claim_id")
  customerId    String?  @map("customer_id")
  customerName  String?  @map("customer_name")
  customerPhone String?  @map("customer_phone")
  supplierId    String?  @map("supplier_id")
  supplierName  String?  @map("supplier_name")
  status        String?
  metadata      Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product   Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("claim_inventory")
}

// ──────────────────────────────────────────────
// 11. BANK ACCOUNTS & STORE SETTINGS
// ──────────────────────────────────────────────

model BankAccount {
  id            String   @id @default(uuid())
  bankName      String   @map("bank_name")
  accountName   String   @map("account_name")
  accountNumber String   @unique @map("account_number")
  branch        String?
  qrCodeUrl     String?  @map("qr_code_url")
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  moneyAccount  MoneyAccount?

  @@map("bank_accounts")
}

model StoreSettings {
  loyaltyConfig Json? @map("loyalty_config")
  id            String   @id @default(uuid())
  storeName     String   @default("ร้านปุริม POS") @map("store_name")
  branchName    String?  @map("branch_name")
  storePhone    String?  @map("store_phone")
  storeAddress  String?  @map("store_address")
  storeEmail    String?  @map("store_email")
  logoUrl       String?  @map("logo_url")
  qrImageUrl    String?  @map("qr_image_url")
  qrLabel       String?  @map("qr_label")
  taxId         String?  @map("tax_id")
  receiptHeader String?  @map("receipt_header")
  receiptFooter String?  @map("receipt_footer")
  backupOffsiteDir String? @map("backup_offsite_dir") // folder on another disk / synced cloud folder for backup copies
  receiptOptions   Json?   @map("receipt_options") // what slips / A4 documents show: { slip: {...}, a4: {...} } (shared/src/receipt-options.ts)
  approvalRules    Json?   @map("approval_rules") // { maxDiscountPercent: {CASHIER: 10, ...}, belowCostNeedsApproval, belowPriceFloorNeedsApproval }
  vatRate       Decimal  @default(7) @map("vat_rate") @db.Decimal(5, 2)
  vatEnabled    Boolean  @default(false) @map("vat_enabled") // store charges VAT on sales (off = no VAT anywhere on bills)
  pointsPerBaht Decimal  @default(0.01) @map("points_per_baht") @db.Decimal(10, 4)
  pointValue    Decimal  @default(1) @map("point_value") @db.Decimal(10, 2)
  lowStockThreshold Decimal @default(5) @map("low_stock_threshold") @db.Decimal(12, 2) // one "low stock" level for every page/report
  allowDecimalQty   Boolean @default(false) @map("allow_decimal_qty") // quantities may have up to 2 decimals (sell by metre / kg)
  cashMovementApprovalLimit Decimal @default(1000) @map("cash_movement_approval_limit") @db.Decimal(12, 2) // drawer cash in/out above this needs a manager PIN (0 = always)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action, createdAt]) // P&L stock write-offs per period (audit_logs grows with every sale)
  @@map("audit_logs")
}

// ─────────────────────────────────────────────
// FINANCE: money accounts, ledger, expenses
// ─────────────────────────────────────────────

/// A place where the store's money is kept. Balance = sum of its transactions.
model MoneyAccount {
  id            String           @id @default(uuid())
  name          String
  type          MoneyAccountType
  bankAccountId String?          @unique @map("bank_account_id")
  terminalId    String?          @unique @map("terminal_id")
  isActive      Boolean          @default(true) @map("is_active")
  sortOrder     Int              @default(0) @map("sort_order")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  bankAccount     BankAccount?         @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  transactions    MoneyTransaction[]
  expenses        Expense[]
  recurring       RecurringExpense[]
  reconciliations BankReconciliation[]

  @@index([type])
  @@map("money_accounts")
}

/// Append-only money ledger. Mistakes are fixed with a reversal row, never by editing.
model MoneyTransaction {
  id              String         @id @default(uuid())
  accountId       String         @map("account_id")
  direction       MoneyDirection
  amount          Decimal        @db.Decimal(12, 2) // always > 0
  // SALE | SALE_REFUND | DEBT_RECEIPT | SUPPLIER_PAYMENT | CLAIM_REFUND | EXPENSE | TRANSFER
  // | OPENING | ADJUSTMENT | OWNER_CAPITAL | OWNER_DRAW | DRAWER_IN | DRAWER_OUT | SHIFT_OVER_SHORT | REVERSAL
  type            String
  categoryId      String?        @map("category_id")
  refType         String?        @map("ref_type") // ORDER | DEBT_PAYMENT | VOUCHER | EXPENSE | SHIFT | CASH_MOVEMENT | CLAIM
  refId           String?        @map("ref_id")
  transferGroupId String?        @map("transfer_group_id")
  reversalOfId    String?        @unique @map("reversal_of_id")
  note            String?
  occurredAt      DateTime       @default(now()) @map("occurred_at")
  userId          String?        @map("user_id")
  reconciledAt     DateTime?     @map("reconciled_at") // matched with a bank statement
  reconciliationId String?       @map("reconciliation_id")
  createdAt       DateTime       @default(now()) @map("created_at")

  account        MoneyAccount        @relation(fields: [accountId], references: [id])
  category       ExpenseCategory?    @relation(fields: [categoryId], references: [id])
  reconciliation BankReconciliation? @relation(fields: [reconciliationId], references: [id])

  @@index([accountId, occurredAt])
  @@index([refType, refId])
  @@index([transferGroupId])
  @@index([type, occurredAt])
  @@map("money_transactions")
}

model ExpenseCategory {
  id           String             @id @default(uuid())
  name         String             @unique
  isActive     Boolean            @default(true) @map("is_active")
  sortOrder    Int                @default(0) @map("sort_order")
  createdAt    DateTime           @default(now()) @map("created_at")
  expenses     Expense[]
  transactions MoneyTransaction[]
  recurring    RecurringExpense[]

  @@map("expense_categories")
}

model Expense {
  id            String    @id @default(uuid())
  expenseNumber String    @unique @map("expense_number") // EXP-YYMMxxxxx
  categoryId    String    @map("category_id")
  accountId     String    @map("account_id")
  amount        Decimal   @db.Decimal(12, 2)
  paidAt        DateTime  @default(now()) @map("paid_at")
  description   String
  vendor        String?
  receiptImage  String?   @map("receipt_image") @db.Text
  status        String    @default("ACTIVE") // ACTIVE | CANCELLED
  cancelledAt   DateTime? @map("cancelled_at")
  cancelReason  String?   @map("cancel_reason")
  userId        String?   @map("user_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  category ExpenseCategory @relation(fields: [categoryId], references: [id])
  account  MoneyAccount    @relation(fields: [accountId], references: [id])

  @@index([paidAt])
  @@index([categoryId])
  @@map("expenses")
}

/// Expense that repeats (rent, salaries, internet). Paying it creates a normal Expense.
model RecurringExpense {
  id          String    @id @default(uuid())
  name        String
  categoryId  String    @map("category_id")
  accountId   String?   @map("account_id") // default account to pay from
  amount      Decimal   @db.Decimal(12, 2) // expected amount (can differ when paid)
  frequency   String    // MONTHLY | WEEKLY | YEARLY
  dayOfMonth  Int?      @map("day_of_month") // 1-31 (MONTHLY / YEARLY)
  monthOfYear Int?      @map("month_of_year") // 1-12 (YEARLY)
  dayOfWeek   Int?      @map("day_of_week") // 0=Sun..6 (WEEKLY)
  nextDueDate DateTime  @map("next_due_date")
  remindDays  Int       @default(3) @map("remind_days")
  isActive    Boolean   @default(true) @map("is_active")
  lastPaidAt  DateTime? @map("last_paid_at")
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  category ExpenseCategory @relation(fields: [categoryId], references: [id])
  account  MoneyAccount?   @relation(fields: [accountId], references: [id])

  @@index([nextDueDate])
  @@map("recurring_expenses")
}

/// One bank-statement check: statement balance vs ledger, with the rows that were ticked off.
model BankReconciliation {
  id               String   @id @default(uuid())
  accountId        String   @map("account_id")
  statementDate    DateTime @map("statement_date")
  statementBalance Decimal  @map("statement_balance") @db.Decimal(12, 2)
  ledgerBalance    Decimal  @map("ledger_balance") @db.Decimal(12, 2)
  difference       Decimal  @db.Decimal(12, 2)
  note             String?
  userId           String?  @map("user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  account      MoneyAccount       @relation(fields: [accountId], references: [id])
  transactions MoneyTransaction[]

  @@index([accountId, statementDate])
  @@map("bank_reconciliations")
}

/// Partial return of a completed bill (some items / quantities), with refund and optional restock.
model OrderReturn {
  id            String   @id @default(uuid())
  returnNumber  String   @unique @map("return_number") // RET-YYMMxxxxx
  orderId       String   @map("order_id")
  shiftId       String?  @map("shift_id")
  userId        String?  @map("user_id")
  refundMethod  String   @map("refund_method") // CASH | TRANSFER | DEBT_REDUCTION
  bankAccountId String?  @map("bank_account_id")
  refundAmount  Decimal  @map("refund_amount") @db.Decimal(12, 2)
  vatAmount     Decimal  @default(0) @map("vat_amount") @db.Decimal(12, 2)
  cogsReturned  Decimal  @default(0) @map("cogs_returned") @db.Decimal(12, 2) // cost of goods put back in stock
  reason        String
  createdAt     DateTime @default(now()) @map("created_at")

  order Order             @relation(fields: [orderId], references: [id])
  items OrderReturnItem[]

  @@index([orderId])
  @@index([createdAt])
  @@map("order_returns")
}

model OrderReturnItem {
  id           String  @id @default(uuid())
  returnId     String  @map("return_id")
  orderItemId  String  @map("order_item_id")
  productId    String  @map("product_id")
  quantity     Decimal @db.Decimal(12, 2) // in the unit it was sold
  baseQuantity Decimal @map("base_quantity") @db.Decimal(12, 2)
  refundAmount Decimal @map("refund_amount") @db.Decimal(12, 2)
  unitCost     Decimal @map("unit_cost") @db.Decimal(10, 2) // per base unit
  restock      Boolean @default(true)

  orderReturn OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([orderItemId])
  @@map("order_return_items")
}

/// Manager approval for an action beyond the requester's rights (discount, below-cost price, ...).
/// channel PIN = approved on the spot with the approver's PIN; REMOTE = request waits for an approver
/// on another device (status PENDING until decided).
model ApprovalRequest {
  id            String    @id @default(uuid())
  type          String // SALE (more types later: VOID, RETURN, DRAWER_OUT ...)
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | USED | EXPIRED
  channel       String // PIN | REMOTE
  requestedById String    @map("requested_by_id")
  approvedById  String?   @map("approved_by_id")
  terminalId    String?   @map("terminal_id")
  contextHash   String    @map("context_hash") // binds the approval to one exact bill
  amount        Decimal   @default(0) @db.Decimal(12, 2)
  reasons       Json // [{ code, message }]
  summary       Json? // what the approver saw (items, totals)
  decisionNote  String?   @map("decision_note")
  expiresAt     DateTime  @map("expires_at")
  decidedAt     DateTime? @map("decided_at")
  usedAt        DateTime? @map("used_at")
  usedRef       String?   @map("used_ref") // order id that consumed it
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([requestedById])
  @@map("approval_requests")
}
