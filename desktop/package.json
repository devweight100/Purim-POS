{
  "name": "purim-pos-desktop",
  "version": "1.4.1",
  "description": "Purim POS Native Desktop Client for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:dir": "electron-builder --dir",
    "build:exe": "electron-builder",
    "build:installer": "bash ../Installer/build-installers.sh client"
  },
  "keywords": [
    "pos",
    "electron",
    "purim-pos",
    "receipt-printer"
  ],
  "author": "Purim POS",
  "license": "ISC",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.purimpos.desktop",
    "productName": "Purim POS",
    "files": [
      "main.js",
      "app-updater.js",
      "splash.html",
      "escpos-raster.js",
      "preload.js",
      "connect-server.html",
      "kick-drawer.exe",
      "kick-drawer.ps1"
    ],
    "asarUnpack": [
      "kick-drawer.exe",
      "kick-drawer.ps1"
    ],
    "directories": {
      "output": "release-bin"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ร้านปุริม POS",
      "artifactName": "Purim-POS-Client-Setup.exe",
      "perMachine": true,
      "runAfterFinish": true,
      "uninstallDisplayName": "Purim POS"
    },
    "publish": null
  }
}
